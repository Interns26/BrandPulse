# --- Application Configuration ---
APP_NAME=BrandPulse
DEBUG=false
BACKEND_PORT=8000

# --- Database Orchestration ---
POSTGRES_USER=brandpulse
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE
POSTGRES_DB=brandpulse
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brandpulse:YOUR_SECURE_PASSWORD_HERE@postgres:5432/brandpulse

# --- AI Machine Learning Settings ---
SENTIMENT_MODEL_PATH=/app/models_storage
INTENT_MODEL_NAME=MoritzLaurer/deberta-v3-base-zeroshot-v1
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN_HERE

# --- Ingestion Configuration ---
RSS_FETCH_INTERVAL_MINUTES=30
RSS_USER_AGENT=BrandPulse/1.0

# Scalable JSON Configuration (Add or remove RSS endpoints here without modifying code)
DEFAULT_RSS_URLS='{"reddit_programming": "https://reddit.com/r/programming/.rss", "reddit_python": "https://reddit.com/r/Python/.rss", "reddit_technology": "https://reddit.com/r/technology/.rss"}'